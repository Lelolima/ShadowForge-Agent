# ============================================================
# NVIDIA ShadowForge Agent - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- NVIDIA API (Required) ---
# Get your key at: https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-xxxxx
NVIDIA_ORG_ID=

# --- NVIDIA NIM Endpoints (Optional - uses cloud by default) ---
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_LOCAL_URL=http://localhost:8000

# --- NVIDIA Riva (Optional - for voice interface) ---
RIVA_SERVER=localhost:50051
RIVA_SSL_ENABLED=false

# --- Metasploit RPC (Optional) ---
MSF_RPC_SENHA=changeme
MSF_RPC_HOST=127.0.0.1
MSF_RPC_PORTA=55553

# --- Burp Suite (Optional) ---
BURP_API_KEY=
BURP_API_HOST=127.0.0.1
BURP_API_PORTA=1337

# --- OSINT APIs (Optional) ---
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=

# --- Proxy & Stealth (Optional) ---
TOR_SOCKS_PROXY=socks5://127.0.0.1:9050
HTTP_PROXY=

# --- Application Config ---
SHADOWFORGE_MODE=stealth
SHADOWFORGE_CONFIG=config/default.yaml
SHADOWFORGE_LOG_DIR=logs
SHADOWFORGE_DATA_DIR=data
